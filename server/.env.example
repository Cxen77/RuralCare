# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=4000

# Auth — generate a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=<generate-a-long-random-string>
JWT_EXPIRES_IN=12h

# development | production
NODE_ENV=development

# Comma-separated origins allowed by CORS in production (dev allows all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082

# Set to true ONLY to intentionally allow the seed script to run against a production DB
SEED_ALLOW_PROD=false
