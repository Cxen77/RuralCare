# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=4000

# Auth — generate a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=<generate-a-long-random-string>
JWT_EXPIRES_IN=12h

# development | production
NODE_ENV=development

# Comma-separated origins allowed by CORS in production (dev allows all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082

# Set to true ONLY to intentionally allow the seed script to run against a production DB
SEED_ALLOW_PROD=false

# ── AI Provider Configuration (One-Click Hot-Swap) ────────────────────────
# Options: groq | gemini | openrouter | huggingface
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini

# Groq Provider (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Provider (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter Provider (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Hugging Face Provider (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Geoapify Routing & Places API (https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
