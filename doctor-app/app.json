{
  "expo": {
    "name": "RuralCare Doctor",
    "slug": "ruralcare-doctor",
    "owner": "cxens-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ruralcare-doctor",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAFA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RuralCare Doctor to access your location?"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MaterialIcons.ttf",
            "./assets/fonts/material.ttf",
            "./assets/fonts/MaterialCommunityIcons.ttf",
            "./assets/fonts/material-community.ttf"
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RuralCare Doctor uses the camera for video consultations.",
        "NSMicrophoneUsageDescription": "RuralCare Doctor uses the microphone for voice and video consultations.",
        "NSLocationWhenInUseUsageDescription": "RuralCare Doctor uses your location to set and show clinic locations."
      }
    },
    "android": {
      "package": "com.ruralcare.doctor",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FAFA"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "5f10abbd-bf52-41cd-a492-1b18c155d67f"
      }
    }
  }
}
