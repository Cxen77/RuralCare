# RuralCare API Configuration
# Web dev default: http://localhost:4000
# Physical mobile device on LAN default: http://192.168.1.5:4000
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000

# Geoapify Map Tiles (free tier: 3000 req/day)
# Get your key at https://myprojects.geoapify.com
EXPO_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key_here
